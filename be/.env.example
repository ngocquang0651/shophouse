# development | production | test
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/luxestore
# Required. In production it must not be this dev value and must be >= 32 chars.
JWT_SECRET=luxestore_dev_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Only read by `npm run seed`. Required and >= 12 chars when NODE_ENV=production.
SEED_ADMIN_PASSWORD=1

# --- Deployment (Render/Railway + Vercel) ---
# "none" when the frontend and API are on different domains (vercel.app + onrender.com).
# Keep "lax" locally or when the frontend proxies /api to this server.
COOKIE_SAME_SITE=lax
# Number of reverse proxies in front of the app. 0 locally, 1 on Render/Railway.
TRUST_PROXY=0
# Public URL of this API, used for uploaded image links. Empty = derived from the request.
PUBLIC_API_URL=
